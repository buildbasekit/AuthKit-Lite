# Copy this file to .env and uncomment only the values you want to override.
# The application runs with the defaults in application.properties when .env is absent.

# External MySQL database (omit to keep the default in-memory H2 database)
# DB_URL=jdbc:mysql://localhost:3306/authkit_lite
# DB_USERNAME=your_database_username
# DB_PASSWORD=your_database_password

# Production JWT secret (at least 32 characters)
# JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars

# Disable the default dummy users outside local/demo environments
# AUTHKIT_DEMO_DATA_ENABLED=false

# JWT overrides
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=14d
# JWT_ISSUER=authkit
# JWT_AUDIENCE=authkit-api

# Graceful-shutdown override
# SHUTDOWN_TIMEOUT=30s

# Passkeys
# PASSKEY_ENABLED=true
# PASSKEY_RP_NAME=BuildBaseKit AuthKit-Lite
# PASSKEY_RP_ID=localhost
# PASSKEY_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
